{
  "$schema": "https://github.com/chen1336166753/LumiBook",
  "deployment": {
    "type": "selfhosted"
  },
  "server": {
    "name": "识光 LumiBook 自托管",
    "externalUrl": "http://localhost:3010"
  },
  "copilot": {
    "enabled": true,
    "byok": {
      "enabled": true,
      "allowCustomEndpoint": true
    }
  },
  "indexer": {
    "enabled": true,
    "provider.type": "embedded"
  }
}
