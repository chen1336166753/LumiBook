{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch 识光 Cloud",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "yarn",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "affine",
        "@lumibook/server",
        "dev"
      ]
    },
    {
      "name": "Lanuch 识光 Web",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "yarn",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "affine",
        "@lumibook/web",
        "dev"
      ]
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Debug 识光 Web",
      "url": "http://localhost:8080"
    }
  ]
}